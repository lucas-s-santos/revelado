# Copie para .env.local e preencha. Nada aqui vai para o git.

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# Banco — Neon (SPEC 2)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Observabilidade (opcional em dev: sem valor, o SDK fica inerte)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- as fases seguintes preenchem daqui para baixo ---

# Storage — Cloudflare R2 (Fase 4)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
NEXT_PUBLIC_R2_PUBLIC_HOST=""

# Auth.js + Resend (Fase 5)
# AUTH_SECRET é OBRIGATÓRIO em produção: assina os links de /sucesso que vão no
# e-mail e os cookies que destravam página com senha. Sem ele o app cai num
# valor de reserva que é público. Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
RESEND_API_KEY=""
EMAIL_FROM="Revelado <ola@revelado.com.br>"

# Mercado Pago (Fase 5)
# MERCADOPAGO_WEBHOOK_SECRET é OBRIGATÓRIO em produção: sem ele o webhook recusa
# toda notificação, de propósito. Webhook de pagamento sem assinatura é porta
# aberta para publicar página de graça. Copie do painel do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Trabalhos agendados (SPEC 9.2)
# CRON_SECRET é OBRIGATÓRIO em produção: sem ele a rota /api/cron recusa tudo,
# de propósito — ela dispara e-mails em massa e a purga de páginas expiradas.
# A Vercel manda este valor como `Authorization: Bearer` nos crons de vercel.json.
# Gere com: openssl rand -base64 32
CRON_SECRET=""

# Inngest — ainda não usado. Os três trabalhos periódicos da SPEC 9.2 rodam por
# cron (ver vercel.json); a fila entra quando houver `media.process`, que é
# disparado por evento e precisa de retry.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Z-API / WhatsApp (Fase 7)
ZAPI_INSTANCE=""
ZAPI_TOKEN=""

# --- desenvolvimento local ---
# Sem DATABASE_URL, os rascunhos vão para .drafts/*.json.
# Sem as chaves do R2, as fotos vão para .drafts/media/.
# Os dois são fallbacks de desenvolvimento e não ligam na Vercel (ver lib/r2.ts).
